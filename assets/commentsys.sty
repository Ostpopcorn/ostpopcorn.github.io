\ProvidesPackage{commentsys}[2026/11/20 Comment system, https://ostpopcorn.github.io/latex/commentsys/]


% Global switch to enable or disable all output of the package.
% Defined (as empty) = enabled, undefined = disabled.
\def\commentsys@global@enable{}
\newcommand{\enablecommentsys}{\def\commentsys@global@enable{}}
\newcommand{\disablecommentsys}{\let\commentsys@global@enable\undefined}

\DeclareOption{enable}{\enablecommentsys}
\DeclareOption{disable}{\disablecommentsys}
\DeclareOption*{\PackageWarning{commentsys}{Unknown option `\CurrentOption'}}

\ProcessOptions\relax


\RequirePackage{soul}% highlighting
\RequirePackage{xcolor}
\RequirePackage[breakable,skins]{tcolorbox}
\RequirePackage{etoolbox}
\RequirePackage{marginnote}


\NewDocumentCommand{\ifcommentsysenable}{mm}{%
    \ifdefined\commentsys@global@enable
        #1%
    \else
        #2%
    \fi
}


% Name-clash detection: \registercommenter{xy} defines \xy, \bxy, \sxy, \ixy
% and \mxy, so refuse to register if any of them already exists.
\newif\ifcommentsys@clash
\newcommand*{\commentsys@checkname}[2]{%
    % #1 = control sequence name to check, #2 = commenter name
    \ifcsname #1\endcsname
        \commentsys@clashtrue
        \PackageError{commentsys}{%
            Cannot register commenter `#2':\MessageBreak
            \@backslashchar#1 is already defined%
        }{%
            \string\registercommenter{#2} would define \@backslashchar#2,
            \@backslashchar b#2, \@backslashchar s#2,\MessageBreak
            \@backslashchar i#2 and \@backslashchar m#2.\MessageBreak
            Choose a name for which none of these exist.%
        }%
    \fi
}


% \registercommenter{<name>}[<full name>]{<initials>}{<color>}[<default>]
%   #1  command name: defines \<name>, \b<name>, \s<name>, \i<name>, \m<name>
%   #2  full name shown in the comment heading (optional, defaults to the initials)
%   #3  initials, used in the inline/margin tag and the comment number
%   #4  base color
%   #5  default style used by \<name>: b (block, the default), s (section),
%       i (inline) or m (margin); see \setdefaultcomment
% Register commenters in the preamble.
\NewDocumentCommand{\registercommenter}{m O{} m m O{b}}{%
    \commentsys@clashfalse
    \commentsys@checkname{#1}{#1}%
    \commentsys@checkname{b#1}{#1}%
    \commentsys@checkname{s#1}{#1}%
    \commentsys@checkname{i#1}{#1}%
    \commentsys@checkname{m#1}{#1}%
    \ifcommentsys@clash\else
        \commentsys@register{#1}{#2}{#3}{#4}%
        \setdefaultcomment{#1}{#5}%
    \fi
}

% \setdefaultcomment{<name>}{<b|s|i|m>}
% Makes \<name> a copy of one of the four comment types:
%   b  block    \b<name>
%   s  section  \s<name>
%   i  inline   \i<name>
%   m  margin   \m<name>
% All four take [<subtitle>]{<text>}, so \<name> has the same interface
% whichever type it copies. Called by \registercommenter; can also be called
% again in the preamble to change a commenter's default.
\NewDocumentCommand{\setdefaultcomment}{m m}{%
    \ifcsname c@commentsys@#1\endcsname
        \ifcsname commentsys@style@#2\endcsname
            \expandafter\DeclareCommandCopy
                \csname #1\expandafter\endcsname
                \csname #2#1\endcsname
        \else
            \PackageError{commentsys}{%
                Unknown default style `#2' for commenter `#1'%
            }{%
                The default style must be b (block), s (section),\MessageBreak
                i (inline) or m (margin).\MessageBreak
                \@backslashchar#1 is left unchanged, or set to b if it\MessageBreak
                had no default yet.%
            }%
            \ifcsname #1\endcsname\else
                \expandafter\NewCommandCopy
                    \csname #1\expandafter\endcsname
                    \csname b#1\endcsname
            \fi
        \fi
    \else
        \commentsys@notregistered{#1}%
    \fi
}
% Types that may be used as a default.
\csdef{commentsys@style@b}{}
\csdef{commentsys@style@s}{}
\csdef{commentsys@style@i}{}
\csdef{commentsys@style@m}{}

\newcommand{\commentsys@notregistered}[1]{%
    \PackageError{commentsys}{%
        Commenter `#1' is not registered%
    }{%
        Register it with \string\registercommenter\space first.%
    }%
}

\newcommand{\commentsys@register}[4]{%
    \newcounter{commentsys@#1}%
    \ifstrempty{#2}%
        {\csdef{commentsys@title@#1}{\textbf{#3}}}%
        {\csdef{commentsys@title@#1}{\textbf{#2}}}%
    \csdef{thecommentsys@#1}{#3.\arabic{commentsys@#1}}%
    \csdef{commentsys@color@#1}{#4}%
    % Deferred so cleveref can be loaded before or after commentsys. This must
    % be begindocument/before (not \AtBeginDocument): cleveref builds its
    % reference formats in its own \AtBeginDocument code, which would run first.
    \AddToHook{begindocument/before}{%
        \ifdefined\crefname
            \crefname{commentsys@#1}{Comment}{Comments}%
        \fi
    }%
    % Block comment: \b<name>[<subtitle>]{<text>}
    \expandafter\NewDocumentCommand\csname b#1\endcsname{o +m}{%
        \ifdefined\commentsys@global@enable
            % Outside the environment so a \label after the command still works.
            \refstepcounter{commentsys@#1}%
            \begin{commentsys@block}{#1}{##1}##2\end{commentsys@block}%
        \else
            \@bsphack\@esphack
        \fi
    }%
    % Section comment: \s<name>[<subtitle>]{<text>}
    \expandafter\NewDocumentCommand\csname s#1\endcsname{o +m}{%
        \ifdefined\commentsys@global@enable
            \refstepcounter{commentsys@#1}%
            \begin{commentsys@section}{#1}{##1}##2\end{commentsys@section}%
        \else
            \@bsphack\@esphack
        \fi
    }%
    % Inline comment: \i<name>[<subtitle>]{<text>}
    \expandafter\NewDocumentCommand\csname i#1\endcsname{o m}{%
        \ifdefined\commentsys@global@enable
            \commentsys@short{#3}{#4}{##1}{##2}%
        \else
            \@bsphack\@esphack
        \fi
    }%
    % Margin comment: \m<name>[<subtitle>]{<text>}
    \expandafter\NewDocumentCommand\csname m#1\endcsname{o m}{%
        \ifdefined\commentsys@global@enable
            \marginnote{\commentsys@short{#3}{#4}{##1}{##2}}%
        \else
            \@bsphack\@esphack
        \fi
    }%
}


% ---------------------------------------------------------------------------
% Public environments, for long comments and comments containing verbatim:
%   \begin{bcomment}{<name>}[<subtitle>] ... \end{bcomment}   (block style)
%   \begin{scomment}{<name>}[<subtitle>] ... \end{scomment}   (section style)
% Put a \label inside the environment to reference the comment.
% When comments are disabled the content is typeset into a box that is thrown
% away, so it does not appear (global side effects, such as a footnote
% stepping the footnote counter, still happen).
% ---------------------------------------------------------------------------
\NewDocumentEnvironment{bcomment}{m o}{%
    \commentsys@envbegin{#1}{\begin{commentsys@block}{#1}{#2}}%
}{%
    \commentsys@envend{\end{commentsys@block}}%
}
\NewDocumentEnvironment{scomment}{m o}{%
    \commentsys@envbegin{#1}{\begin{commentsys@section}{#1}{#2}}%
}{%
    \commentsys@envend{\end{commentsys@section}}%
}

% #1 = commenter name, #2 = code that opens the comment
\newcommand{\commentsys@envbegin}[2]{%
    \ifcsname c@commentsys@#1\endcsname\else
        \commentsys@notregistered{#1}%
        \let\commentsys@global@enable\undefined% discard this comment only
    \fi
    \ifdefined\commentsys@global@enable
        \def\commentsys@envon{}%
        \refstepcounter{commentsys@#1}%
        #2%
    \else
        \let\commentsys@envon\undefined
        \@bsphack
        \setbox\z@\vbox\bgroup
    \fi
}
% #1 = code that closes the comment
\newcommand{\commentsys@envend}[1]{%
    \ifdefined\commentsys@envon
        #1%
    \else
        \egroup
        \@esphack
    \fi
}


% ---------------------------------------------------------------------------
% Internal environments that draw the two styles.
% Both take #1 = commenter name and #2 = subtitle (may be -NoValue-).
% Neither steps the counter; the callers do that.
% ---------------------------------------------------------------------------

% Sets \commentsys@c to the commenter's base color.
\newcommand{\commentsys@setcolor}[1]{%
    \edef\commentsys@c{\csname commentsys@color@#1\endcsname}%
}

% Heading text shared by both styles: name --- subtitle, number on the right.
\newcommand{\commentsys@heading}[2]{%
    \csname commentsys@title@#1\endcsname
    \IfNoValueF{#2}{ --- \textbf{#2}}%
    \hfill{\small(\textbf{\csname thecommentsys@#1\endcsname})}%
}

% Block style: a breakable tcolorbox.
\NewDocumentEnvironment{commentsys@block}{m m}{%
    \commentsys@setcolor{#1}%
    % \tikzexternaldisable only makes local assignments, so the environment's
    % group restores whatever externalization state the user had before.
    \ifcsname tikz@library@external@loaded\endcsname
        \tikzexternaldisable
    \fi
    \begin{tcolorbox}[%
        title=\commentsys@heading{#1}{#2},
        colback=\commentsys@c!5!white,
        colframe=\commentsys@c!75!black,
        left=5pt, right=5pt, top=0pt, bottom=0pt,
        breakable, skin=enhanced]%
}{%
    \end{tcolorbox}%
}

% Section style: no box, so it breaks across pages like ordinary text.
% Thin rule, lightly tinted heading bar, near-black indented text, thin rule.
\newcommand{\commentsys@srule}{0.4pt}% thickness of the two rules
\newcommand{\commentsys@sskip}{\medskipamount}% space before and after
\newcommand{\commentsys@spad}{1mm}% heading padding, space around the text
\newcommand{\commentsys@sindent}{5pt}% text inset from the heading edge
% Paragraph spacing of the document body, so a comment inside a list does not
% pick up that list's spacing.
\newskip\commentsys@parskip
\AtBeginDocument{\commentsys@parskip\parskip}

\NewDocumentEnvironment{commentsys@section}{m m}{%
    \commentsys@setcolor{#1}%
    % The paragraph after the comment adds \parskip below it, so add the same
    % above to keep the spacing symmetric (matters with the parskip package).
    \par\addvspace{\glueexpr\commentsys@sskip+\parskip\relax}%
    % Top rule and heading bar as one box, so they never separate. Moved right
    % by \@totalleftmargin so it lines up inside lists.
    \moveright\@totalleftmargin\vbox{%
        \hsize\linewidth
        {\color{\commentsys@c!60!black}\hrule width \linewidth height \commentsys@srule}%
        \fboxsep\commentsys@spad
        \hbox{\colorbox{\commentsys@c!8!white}{%
            \parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
                \leftskip\commentsys@sindent
                \rightskip\commentsys@sindent
                \parfillskip\z@
                \color{\commentsys@c!60!black}%
                \strut\commentsys@heading{#1}{#2}\strut
            }%
        }}%
        \kern\z@% zero depth, so the text below is placed from the bar
    }%
    \nointerlineskip
    \color{\commentsys@c!25!black}%
    \nobreak
    % Directly after \section etc. LaTeX's "no break after heading" flag is
    % still set, and a list started then skips its top spacing, which made
    % the text touch the heading bar. The bar is already kept with the
    % section title by the penalties, so the flag can be cleared here.
    \@nobreakfalse
    % A list gives the text its inset (and a correct \linewidth) while
    % keeping ordinary paragraphs, page breaks, footnotes and floats.
    % The penalties keep the heading with the first line and the bottom
    % rule with the last line.
    % \list sets its margins without a group of its own, so add one; the
    % bottom rule is then drawn with the surrounding margins again.
    \begingroup
    % LaTeX adds the surrounding \parskip above a list; zero it so the gap
    % under the heading is exactly \commentsys@spad. Paragraphs inside the
    % comment still get the document's \parskip through \parsep below.
    \parskip\z@
    \@beginparpenalty\@M
    \@endparpenalty\@M
    \list{}{%
        \leftmargin\dimexpr\commentsys@spad+\commentsys@sindent\relax
        \rightmargin\leftmargin
        \topsep\commentsys@spad
        \partopsep\z@
        \parsep\commentsys@parskip
        \itemsep\z@
        \listparindent\parindent
        \itemindent\z@
    }%
    \item\relax
}{%
    \endlist
    \endgroup
    \nobreak
    \nointerlineskip
    \moveright\@totalleftmargin\vbox{%
        \hsize\linewidth
        \color{\commentsys@c!60!black}\hrule width \linewidth height \commentsys@srule
    }%
    \addvspace{\commentsys@sskip}%
}


% Content of inline and margin comments: tag, optional bold subtitle, text.
% #1 = initials, #2 = color, #3 = subtitle (may be -NoValue-), #4 = text
% soul cannot highlight citations, so only the initials are highlighted and
% the subtitle and text are just colored.
\newcommand{\commentsys@short}[4]{%
    \commentsys@tag{#1}{#2}%
    \textcolor{#2}{{ \IfNoValueF{#3}{\textbf{#3:} }#4}}%
}

% Highlighted initials tag shared by the inline and margin commands.
% #1 = initials, #2 = color
\newcommand{\commentsys@tag}[2]{%
    \textcolor{white}{\sethlcolor{#2!75!black}\hl{\,\textbf{#1}:\,}}%
}